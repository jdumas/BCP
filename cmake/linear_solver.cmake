# No automatic fallback: a requested performance backend must be available.
string(TOUPPER "${BCP_LINEAR_SOLVER}" BCP_LINEAR_SOLVER)
if(BCP_LINEAR_SOLVER STREQUAL "PANUA")
    find_library(BCP_PARDISO_LIBRARY NAMES pardiso libpardiso HINTS "$ENV{PARDISO_BIN}" REQUIRED)
    add_library(bcp_linear_solver INTERFACE)
    target_link_libraries(bcp_linear_solver INTERFACE "${BCP_PARDISO_LIBRARY}")
    target_include_directories(bcp_linear_solver INTERFACE "${PROJECT_SOURCE_DIR}/portable")
    target_compile_definitions(bcp_linear_solver INTERFACE BCP_PANUA_PARDISO)
elseif(BCP_LINEAR_SOLVER STREQUAL "MKL" OR BCP_LINEAR_SOLVER STREQUAL "EIGEN")
    if(BCP_LINEAR_SOLVER STREQUAL "MKL")
        if(DEFINED MKL_INTERFACE AND NOT MKL_INTERFACE STREQUAL "lp64")
            message(FATAL_ERROR "BCP uses int indices and requires MKL_INTERFACE=lp64")
        endif()
        set(MKL_INTERFACE lp64)
        if(NOT DEFINED MKL_THREADING)
            if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
                set(MKL_THREADING gnu_thread)
            elseif(CMAKE_CXX_COMPILER_ID MATCHES "^Intel")
                set(MKL_THREADING intel_thread)
            else()
                # MSVC uses vcomp and Clang uses libomp for our OpenMP loops.
                # Parallel MKL/TBB avoids loading a second OpenMP runtime.
                set(MKL_THREADING tbb_thread)
            endif()
        endif()
        if(MKL_THREADING STREQUAL "tbb_thread")
            find_package(TBB CONFIG REQUIRED)
        endif()
        find_package(MKL CONFIG REQUIRED HINTS "$ENV{CONDA_PREFIX}" "$ENV{CONDA_PREFIX}/Library" "$ENV{MKLROOT}")
        add_library(bcp_linear_solver STATIC portable/pardiso_mkl.cpp portable/pardiso_checks.cpp)
        target_link_libraries(bcp_linear_solver PRIVATE MKL::MKL)
    else()
        message(STATUS "Explicit Eigen fallback selected; not a PARDISO performance substitute")
        add_library(bcp_linear_solver STATIC portable/pardiso_eigen.cpp portable/pardiso_checks.cpp)
    endif()
    target_link_libraries(bcp_linear_solver PUBLIC Eigen3::Eigen)
    target_include_directories(bcp_linear_solver PUBLIC "${PROJECT_SOURCE_DIR}/portable")
    target_compile_definitions(bcp_linear_solver PUBLIC BCP_PARDISO_COMPAT)
else()
    message(FATAL_ERROR "Unknown BCP_LINEAR_SOLVER=${BCP_LINEAR_SOLVER}; select MKL, PANUA or EIGEN")
endif()
message(STATUS "BCP sparse solver backend: ${BCP_LINEAR_SOLVER}")
